    "# Normalization of lengths to avoid error\n",
    "m = min(len(time), len(mouseX), len(mouseY), len(in_target))\n",
    "time = time[:m]\n",
    "mouseX = mouseX[:m]\n",
    "mouseY = mouseY[:m]\n",
    "in_target = in_target[:m]\n",
    "\n",
    "# Principal loop over records\n",
    "records_data = []\n",
    "\n",
